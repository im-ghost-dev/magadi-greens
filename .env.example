# ==============================================================================
# MAGADI GREENS — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma)
# ------------------------------------------------------------------------------
# For Local SQLite Development:
# DATABASE_URL="file:./prisma/dev.db"
#
# For Production / Supabase Postgres (Vercel):
# Transaction pooler URL (port 6543, pgbouncer=true) for serverless API routes:
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct session URL (port 5432) for Prisma CLI migrations & schema push:
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"


# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
# Secure password for the shopkeeper admin panel (/admin).
# Change this to a strong, random password for production.
ADMIN_PASSWORD="change_this_to_a_secure_admin_password"


# ------------------------------------------------------------------------------
# 3. SUPABASE STORAGE & CLIENT (Photo Uploads)
# ------------------------------------------------------------------------------
# Found in Supabase Project Settings -> API:
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Service role secret key (server-only, required for photo uploads):
# WARNING: NEVER expose this key to the browser or commit it to git.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional: Public storage bucket name (defaults to "product-photos"):
SUPABASE_BUCKET="product-photos"
